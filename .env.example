# LLM / Agent
MODEL_NAME=google_genai:gemini-3-flash-preview
SUMMARY_MODEL=google_genai:gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# OpenAI 生图默认使用 Flare；运行时可通过 /image 切换为 Sunburst。
IMAGE_MODEL_NAME=gpt-image-2.5-flare
NEXT_IMAGE_PROVIDER=openai
ENABLE_TOOLS=1
DRY_RUN=0
THREAD_ID=v1_0
STORE_ID=v1_0
LOCAL_IMG=1
FORMAT=1

# Database
LANGGRAPH_PG=postgresql://languser:langpass@localhost:5432/langgraph
SYS_MSG_FILE=./prompts/# to be filled
THREAD_STORE_FILE=.qq_group_threads.json
REMINDER_STORE_FILE=.qq_reminder_threads.json
MEMORY_STORE_FILE=.qq_group_memnames.json

# Keys
GOOGLE_APPLICATION_CREDENTIALS=/app/secret/xxxxxxxx.json
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=projectID
GOOGLE_CLOUD_LOCATION=global

OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
OPENWEATHERMAP_API_KEY=
SERPAPI_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOTEL_HOST=
VISUAL_CROSSING_API_KEY=
QWEATHER_API_HOST=
QWEATHER_API_KEY=
TWELVE_API_KEY=
X_BEARER_TOKEN=


# Net
BOT_HOST=0.0.0.0
BOT_PORT=8080
ONEBOT_API_BASE=http://127.0.0.1:3001
ONEBOT_SECRET=
ONEBOT_ACCESS_TOKEN=

# QQ Bot
ALLOWED_GROUPS=
BLACKLIST_GROUPS=
LIMIT_GROUPS=
CMD_ALLOWED_USERS=
# 设为 1 时使用动态时间提醒，并为引用消息附带发送时间
ENABLE_DATETIME_SYSTEM_REMINDER=0
DAILY_TASK=
DAILY_TASK_TIME=
DAILY_TASK_CITY=京都市中京区
NIGHTLY_TASK=
NIGHTLY_TASK_TIME=
TICKET_TASK=
TICKET_TASK_TIME=
X_MONITOR_NEW_POST_NOTICE=0
X_MONITOR_TRANSLATION_MODE=none
X_MONITOR_TRANSLATION_MODEL=gemini-3.5-flash-lite
X_MONITOR_STORE=.x_monitor.json
# X API 余额或用量耗尽通知目标，格式：群号,QQ号；留空时不通知
X_MONITOR_ALERT=

# 其他
WAIT_PG=1
